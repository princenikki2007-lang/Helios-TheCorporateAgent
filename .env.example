# ==============================================================================
# HELIOS — Legal & Compliance Intelligence Platform
# Production & Serverless Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Server-Side AI Intelligence Gateway (Gemini 1.5 Flash / Pro)
# NOTE: Never expose AI keys in frontend code. The platform manages model access server-side.
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Multi-Tenant Database & Persistence (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/helios_compliance

# Authentication & Session Security (JWT / NextAuth)
AUTH_SECRET=your_32_character_cryptographic_secret_here
SESSION_TIMEOUT_MINUTES=60

# Secure Object Storage (AWS S3 / Google Cloud Storage / Supabase Storage)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=helios-corporate-vault
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key

# External Regulatory & Statutory Integrations (Optional)
# When not connected, HELIOS displays "Integration Not Connected" without fabricating data.
GST_GSP_CLIENT_ID=
GST_GSP_CLIENT_SECRET=
MCA_V3_API_KEY=
